DATABASE_URL=postgresql://esg:esg@localhost:5432/esg
APP_SECRET=change-me-to-a-long-random-string
SEED_DEMO_DATA=false
ADMIN_EMAIL=admin@yourcompany.example
ADMIN_PASSWORD=choose-a-strong-password
ALERT_INTERVAL_SEC=300
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=esg-alerts@example.org
VESSEL_AUX_LOAD_FACTOR=0.4
EVIDENCE_DIR=./data/evidence
# Field evidence OCR: auto | rapidocr | tesseract | azure | none
OCR_PROVIDER=auto
# Only for OCR_PROVIDER=azure (Azure AI Document Intelligence, prebuilt-read). Photos are sent to this service.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
APP_TZ=Asia/Dubai
EVIDENCE_STALE_HOURS=24
